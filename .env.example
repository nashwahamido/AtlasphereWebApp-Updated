# Copy this file to .env and fill in real values. Never commit .env.

# ── Database (Aiven MySQL) ────────────────────────────────────────────────
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_DATABASE=
DB_PASSWORD=

# ── Email (Mailjet transactional HTTP API) ────────────────────────────────
# Works on Railway, which blocks outbound SMTP ports. Set these up at:
#   API keys: Mailjet dashboard → Account settings → API Key Management
#   Sender:   Mailjet dashboard → Account settings → Senders & Domains
#             (verify the individual email address you put in MAIL_FROM)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM=you@example.com
MAIL_FROM_NAME=Atlasphere

# ── Travel Advisor (RapidAPI) ─────────────────────────────────────────────
RAPIDAPI_KEY=
RAPIDAPI_HOST=travel-advisor.p.rapidapi.com
