# Copy this file to .env and fill in real values. Never commit .env.

# ── Database (Aiven MySQL) ────────────────────────────────────────────────
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_DATABASE=
DB_PASSWORD=

# ── Email (Brevo transactional HTTP API) ──────────────────────────────────
# Works on Railway, which blocks outbound SMTP ports. Set these up at:
#   API key: Brevo dashboard → SMTP & API → API Keys
#   Sender:  Brevo dashboard → Senders, Domains & Dedicated IPs → Senders
#            (verify the individual email address you put in MAIL_FROM)
BREVO_API_KEY=
MAIL_FROM=you@example.com
MAIL_FROM_NAME=Atlasphere

# ── Places (Foursquare Places API) ────────────────────────────────────────
# City attractions / recommendations. Get a Service key at:
#   https://foursquare.com/developers/  →  create a project  →  copy the key
FOURSQUARE_API_KEY=
# Optional — bump if Foursquare changes the required API version date.
FOURSQUARE_API_VERSION=2025-06-17
