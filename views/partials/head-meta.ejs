<%
  /* Site icon + link-preview (Open Graph / Twitter) tags, shared by every page.
     siteUrl/pageUrl come from the middleware in server.js; previews need absolute URLs. */
  var _site = (typeof siteUrl !== 'undefined' && siteUrl) ? siteUrl : 'https://atlasphere.up.railway.app';
  var _url = (typeof pageUrl !== 'undefined' && pageUrl) ? pageUrl : _site + '/';
  var _title = (typeof metaTitle !== 'undefined' && metaTitle) ? metaTitle : 'Atlasphere: stop planning, start going';
  var _desc = (typeof metaDescription !== 'undefined' && metaDescription) ? metaDescription : 'Turn group chats into group trips: plan, vote on things to do and build the itinerary together.';
%>
  <meta name="description" content="<%= _desc %>">
  <meta name="theme-color" content="#0B3856">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Atlasphere">
  <meta property="og:title" content="<%= _title %>">
  <meta property="og:description" content="<%= _desc %>">
  <meta property="og:url" content="<%= _url %>">
  <meta property="og:image" content="<%= _site %>/og-image.jpg">
  <meta property="og:image:secure_url" content="<%= _site %>/og-image.jpg">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Atlasphere: stop planning, start going">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= _title %>">
  <meta name="twitter:description" content="<%= _desc %>">
  <meta name="twitter:image" content="<%= _site %>/og-image.jpg">
