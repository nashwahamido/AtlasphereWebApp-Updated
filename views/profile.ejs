<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8">
    <title>Profile Atlasphere</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('partials/head-meta') %>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/lipis/flag-icons@7.2.3/css/flag-icons.min.css"/>

    <style>
      .profile-avatar {
        width: 200px;
        height: 200px;
        overflow: hidden;
        position: relative;
        cursor: pointer;
        margin: 0 auto 24px;
        border-radius: 50%;
        background-color: #c8d8e8;
      }

      .profile-avatar:hover .avatar-upload-overlay {
        opacity: 1;
      }

      .iprofileImg {
        width: 200px;
        height: 200px;
        margin: 0;
        padding: 0;
      }

      .personalProfileImg {
        width: 200px;
        height: 200px;
        object-fit: cover;
        border-radius: 50%;
        display: block;
      }

      .avatar-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .avatar-placeholder svg {
        width: 70%;
        height: 70%;
      }

      .avatar-upload-overlay {
        position: absolute;
        bottom: 10px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0,0,0,0.6);
        color: #fff;
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        opacity: 0;
        transition: opacity 0.3s;
        pointer-events: none;
        z-index: 2;
      }

      .profile-upload-input {
        display: none;
      }

    </style>
  </head>
  <body>
    <%- include('partials/navbar', { user: typeof user !== 'undefined' ? user : null }) %>

    <main class="profile-main">
      <h1>Profile</h1>

      <form action="/profile/upload" method="post" enctype="multipart/form-data" id="profileUploadForm">
        <div class="profile-avatar" onclick="document.getElementById('profilePicInput').click();">
          <% if (image) { %>
            <figure class="iprofileImg">
              <img src="<%= image %>" alt="profile picture" class="personalProfileImg" id="avatarPreview">
            </figure>
          <% } else { %>
            <div class="avatar-placeholder" id="avatarPlaceholder">
              <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                <circle cx="50" cy="35" r="20" fill="#9ab"/>
                <ellipse cx="50" cy="85" rx="30" ry="25" fill="#9ab"/>
              </svg>
            </div>
            <figure class="iprofileImg" style="display:none;">
              <img src="" alt="profile picture" class="personalProfileImg" id="avatarPreview">
            </figure>
          <% } %>
          <span class="avatar-upload-overlay">Change photo</span>
        </div>
        <input type="file" name="profilePicture" accept="image/*" id="profilePicInput" class="profile-upload-input">
      </form>

      <div class="username-pill">
        <%= user ? user.username : 'Username' %>
      </div>

      <%
        var visited = (user && user.visitedCountries) || [];
        var planning = (user && user.planningCountries) || [];
        var cities = (user && user.visitedCities) || [];
        var groupCount = user ? (user.groups_created || 0) : 0;
        function cCode(c) { return String((c && c.code) || c || '').toLowerCase(); }
        function cName(c) { return (c && c.name) || String(c || '').toUpperCase(); }
      %>

      <div class="pf-stats">
        <div class="pf-stat">
          <span class="pf-stat__num"><%= visited.length %></span>
          <span class="pf-stat__label"><%= visited.length === 1 ? 'Country visited' : 'Countries visited' %></span>
        </div>
        <div class="pf-stat">
          <span class="pf-stat__num"><%= planning.length %></span>
          <span class="pf-stat__label">Planning to visit</span>
        </div>
        <div class="pf-stat">
          <span class="pf-stat__num"><%= groupCount %></span>
          <span class="pf-stat__label"><%= groupCount === 1 ? 'Group' : 'Groups' %></span>
        </div>
      </div>

      <div class="pf-sections">
        <section class="pf-card" aria-labelledby="pfVisited">
          <div class="pf-card__head">
            <h2 class="pf-card__title" id="pfVisited">Visited</h2>
            <a href="/settings" class="pf-card__action">Edit</a>
          </div>
          <% if (visited.length > 0) { %>
            <ul class="pf-countries">
              <% visited.forEach(function(country) { %>
                <li class="pf-country" title="<%= cName(country) %>">
                  <span class="fi fi-<%= cCode(country) %> pf-country__flag" aria-hidden="true"></span>
                  <span class="pf-country__name"><%= cName(country) %></span>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <p class="pf-empty">No countries yet. <a href="/settings">Add the places you've been</a></p>
          <% } %>

          <% if (cities.length > 0) { %>
            <h3 class="pf-card__sub">Cities</h3>
            <ul class="pf-cities">
              <% cities.forEach(function(city) { %>
                <li class="pf-city"><%= city %></li>
              <% }) %>
            </ul>
          <% } %>
        </section>

        <section class="pf-card" aria-labelledby="pfPlanning">
          <div class="pf-card__head">
            <h2 class="pf-card__title" id="pfPlanning">Planning to visit</h2>
            <a href="/groups/create/country" class="pf-card__action">+ Trip</a>
          </div>
          <% if (planning.length > 0) { %>
            <ul class="pf-countries">
              <% planning.forEach(function(country) { %>
                <li class="pf-country" title="<%= cName(country) %>">
                  <span class="fi fi-<%= cCode(country) %> pf-country__flag" aria-hidden="true"></span>
                  <span class="pf-country__name"><%= cName(country) %></span>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <p class="pf-empty">No trips yet. <a href="/groups/create/country">Plan your first trip</a></p>
          <% } %>
        </section>
      </div>
    </main>

    <%- include('partials/footer') %>

    <script>
      var s=localStorage.getItem('atlasphere-theme');if(s)document.documentElement.setAttribute('data-theme',s);
      document.getElementById('profilePicInput').addEventListener('change', function(e) {
        var file = e.target.files[0];
        if (!file) return;
        document.getElementById('profileUploadForm').submit();
      });
    </script>
  </body>
</html>